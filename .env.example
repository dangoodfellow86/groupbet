# ==========================================
# Groupbet Environment Configuration (Alpha / Production)
# ==========================================

# 1. Supabase Client & Realtime (Required for Auth & Realtime updates)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key...

# 2. PostgreSQL Connection Pooler (Supabase or direct Postgres)
# Tip: On Vercel / serverless, use Supabase Pooler URI (port 6543 or 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true

# 3. Application Public URL (Critical for OAuth redirects, Auth email links, and WhatsApp sharing)
# In production, set to your Vercel deployment URL (e.g. https://groupbet.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 4. Football-Data.org API (Optional: fallback Premier League fixture sync)
FOOTBALL_DATA_API_KEY=your_api_key_here

# 5. Webhook & Protected Cron Endpoints (Optional)
FOOTBALL_WEBHOOK_SECRET=your_webhook_hmac_secret_here
CRON_SECRET=your_cron_secret_token_here
